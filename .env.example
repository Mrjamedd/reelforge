# ─── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://reelforge:reelforge@localhost:5432/reelforge

# ─── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Object Storage ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local        # "local" or "s3"
LOCAL_STORAGE_PATH=./storage # only used when STORAGE_BACKEND=local
S3_BUCKET=your-bucket-name
S3_ENDPOINT_URL=             # leave blank for AWS; set for MinIO or Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Admin Seed Account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123!

# ─── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── TikTok ────────────────────────────────────────────────────────────────────
# TODO: Apply at https://developers.tiktok.com — requires app approval
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Instagram / Meta ──────────────────────────────────────────────────────────
# TODO: Apply at https://developers.facebook.com — requires app review + Business account
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── YouTube / Google ──────────────────────────────────────────────────────────
# TODO: Create credentials at https://console.cloud.google.com
# Enable: YouTube Data API v3
# OAuth redirect URI: {API_URL}/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─── Misc ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # "development" or "production"
LOG_LEVEL=INFO
