# ─── ReelPush Production Environment ───────────────────────────────────────────
# Copy to .env and fill in all required values before deploying.
# Never commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to set POSTGRES_PASSWORD env and DATABASE_URL.
POSTGRES_PASSWORD=change-me-strong-password

# ─── Core ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production
LOG_LEVEL=WARNING
SQLALCHEMY_ECHO=false

# ─── Object Storage ────────────────────────────────────────────────────────────
# Use "local" for OCI block storage. Media served from /media/* on the backend.
# Switch to "s3" (R2/S3) if you need Instagram publishing (requires public URLs).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/storage

# ─── App URL (public-facing) ───────────────────────────────────────────────────
# Set to your OCI server's public IP or domain name.
# OAuth callbacks and local media URLs are built from this.
# Example: http://1.2.3.4:8100   OR   https://reelpush.yourdomain.com
API_URL=http://YOUR_OCI_PUBLIC_IP:8100

# ─── Admin Seed Account ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-secure-password

# ─── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Instagram / Meta ──────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match a supported version in the Meta Developer dashboard / API Upgrade Tool.
META_GRAPH_API_VERSION=v21.0

# ─── YouTube / Google ──────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ─── OCI Memory Tuning (optional) ──────────────────────────────────────────────
# Defaults fit a 1 GB AMD instance alongside the Discord bot.
# On Ampere A1 (24 GB) you can remove these or raise them substantially.
# DB_MEM_LIMIT=192m
# REDIS_MEM_LIMIT=64m
# BACKEND_MEM_LIMIT=256m
# WORKER_MEM_LIMIT=192m
